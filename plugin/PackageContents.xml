<?xml version="1.0" encoding="utf-8"?>
<ApplicationPackage SchemaVersion="1.0"
                    AutodeskProduct="AutoCAD"
                    Name="C3dMcpBridge"
                    Description="Local MCP bridge for Civil 3D with drawing-scoped edit permission"
                    AppVersion="0.12.0"
                    ProductType="Application"
                    Author="Local"
                    ProductCode="{3B8E5A52-7C41-4D0A-9E6F-21A4C7D90B13}"
                    UpgradeCode="{6F2B3C1A-9D84-4E57-A1C3-5B7E0D2F8A46}">
  <CompanyDetails Name="Local" />

  <!-- One component per Civil 3D release; AutoCAD loads only the one whose series matches. -->
  <Components Description="Civil 3D 2024 (.NET Framework 4.8)">
    <!-- Contents\2024 also holds System.Text.Json and its dependencies. -->
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R24.3" SeriesMax="R24.3" />
    <ComponentEntry AppName="C3dMcpBridge"
                    ModuleName="./Contents/2024/C3dMcpBridge.dll"
                    AppDescription="Civil 3D MCP bridge (.NET Framework 4.8)"
                    LoadOnAppStartup="true" />
  </Components>

  <Components Description="Civil 3D 2025 (.NET 8)">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R25.0" SeriesMax="R25.0" />
    <ComponentEntry AppName="C3dMcpBridge"
                    ModuleName="./Contents/2025/C3dMcpBridge.dll"
                    AppDescription="Civil 3D MCP bridge (.NET 8)"
                    LoadOnAppStartup="true" />
  </Components>

  <Components Description="Civil 3D 2027 (.NET 10)">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R26.0" SeriesMax="R26.0" />
    <ComponentEntry AppName="C3dMcpBridge"
                    ModuleName="./Contents/2027/C3dMcpBridge.dll"
                    AppDescription="Civil 3D MCP bridge (.NET 10)"
                    LoadOnAppStartup="true" />
  </Components>
</ApplicationPackage>
